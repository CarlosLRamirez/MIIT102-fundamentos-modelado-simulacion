</tr>
<tr class="odd">
<td>Calidad y claridad de la presentación oral</td>
<td>5</td>
</tr>
<tr class="even">
<td><strong>Total</strong></td>
<td><strong>100</strong></td>
</tr>
</tbody>
</table>
